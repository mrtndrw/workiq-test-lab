# Microsoft Entra app registration (Web platform / confidential client)
# See docs/tenant-setup.md for manual and scripted setup.
ENTRA_TENANT_ID=your-directory-tenant-id
ENTRA_CLIENT_ID=your-app-registration-client-id
ENTRA_CLIENT_SECRET=your-client-secret-value

# OAuth redirect URI registered on the app (Web platform).
# Must exactly match what you add in Entra. Default works for local use.
REDIRECT_URI=http://localhost:3000/auth/callback

# Secret used to sign the session cookie.
# Use a long random value and keep it stable across restarts. The MSAL cache is
# stored in owner-only local files (.sessions is 0700; its files are 0600).
SESSION_SECRET=change-me-to-a-long-random-string

# Local server port and loopback listener
PORT=3000
HOST=127.0.0.1
# Hosted deployments must terminate HTTPS at a hardened proxy before explicitly
# opting into a non-loopback listener. PORT is the private Node listener and
# does not need to match the public HTTPS port in REDIRECT_URI.
# WORKIQ_ALLOW_REMOTE_BIND=false

# REST uses the /rest route by default. Set to beta only when testing
# preview-only request or response shapes.
# WORKIQ_REST_CHANNEL=beta
# REST and A2A HTTP/SSE timeout in ms (default 120000):
# WORKIQ_HTTP_TIMEOUT_MS=120000

# --- MCP transport (optional) ---
# How the MCP toggle talks to Work IQ:
#   remote (default) = MCP-over-HTTP, reuses your delegated WorkIQAgent.Ask token (no CLI)
#   local            = runs the lockfile-pinned @microsoft/workiq CLI (its own sign-in)
WORKIQ_MCP_TRANSPORT=remote
# Override the remote MCP endpoint (default shown):
# WORKIQ_MCP_URL=https://workiq.svc.cloud.microsoft/mcp
# Identity-changing remote-to-local fallback is not supported.
WORKIQ_MCP_REMOTE_FALLBACK=off
# Local MCP EULA acceptance must be an explicit operator decision:
# WORKIQ_MCP_ACCEPT_EULA=false
# Per-tool call timeout in ms (agentic `ask` can be slow; default 180000):
# WORKIQ_MCP_TIMEOUT_MS=180000


# --- Agent (LLM) mode - optional Azure OpenAI on your tenant ---
# The agent is an LLM that orchestrates Work IQ via the enabled backends (REST/A2A/MCP).
# Auth is Entra ID via DefaultAzureCredential (run `az login`). NO API key is used —
# key auth may be disabled on the resource (disableLocalAuth=true). The signed-in
# identity needs the "Cognitive Services OpenAI User" role on the resource.
# AZURE_OPENAI_ENDPOINT=https://<your-aoai-resource>.openai.azure.com/
# Use the deployment name from Foundry, not the underlying model name.
# AZURE_OPENAI_DEPLOYMENT=<your-default-deployment-name>
# AZURE_OPENAI_API_VERSION=2024-10-21
# Optional comma-separated deployment names to offer in the model picker. Every
# entry must exist on the same resource and include the default deployment.
# AZURE_OPENAI_DEPLOYMENTS=<your-default-deployment-name>,<another-deployment-name>
# Local option A: run `az login` as a user with Cognitive Services OpenAI User.
# Local option B: use a separate service principal with that role scoped only to
# the Azure OpenAI resource. Do not reuse the ENTRA_* web-app credentials.
# AZURE_TENANT_ID=<azure-resource-tenant-id>
# AZURE_CLIENT_ID=<azure-openai-runtime-app-client-id>
# AZURE_CLIENT_SECRET=<azure-openai-runtime-app-secret-value>
# Azure hosting: prefer managed identity instead of a client secret. A
# user-assigned managed identity can be selected with AZURE_CLIENT_ID alone.
# Max agent tool-calling iterations per question:
LLM_MAX_STEPS=12
